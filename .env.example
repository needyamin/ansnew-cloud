# ---------------------------------------------------------------------------
# ANSNEW CLOUD configuration.  Copy to `.env` and adjust.  Never commit real secrets.
#
# These defaults are PRODUCTION-SAFE (HTTPS + ports 80/443 + a generated admin
# password). For a local/dev instance set APP_URL=http://localhost:9090,
# SESSION_SECURE_COOKIE=false, HTTP_PORT=9090, HTTPS_PORT=9443 instead.
# Full deployment walkthrough: docs/DEPLOY.md
# ---------------------------------------------------------------------------

# --- Container images -----------------------------------------------------
# Where each component's image comes from. Defaults build/pull the local names.
# To publish to your own registry, point all four at one repository and use a
# tag per component, then `docker compose build && docker compose push`; on the
# server set the same four values and run `docker compose pull && docker compose
# up -d --no-build`. Example:
#   IMAGE_NGINX=youruser/ansnew-cloud:nginx
#   IMAGE_PHP=youruser/ansnew-cloud:php
#   IMAGE_WS=youruser/ansnew-cloud:ws
#   IMAGE_NAS=youruser/ansnew-cloud:nas
# (Docker Hub allows only ONE slash: namespace/repository. Four separate
# repositories — youruser/ansnew-nginx etc. — work just as well.)
IMAGE_NGINX=ansnew/nginx
IMAGE_PHP=ansnew/php
IMAGE_WS=ansnew/ws
IMAGE_NAS=ansnew/nas

# Canonical base URL users open in the browser (no trailing slash).
# Must match the scheme/host you actually serve, or the same-origin check
# (Request::originIsTrusted) will reject state-changing requests.
APP_URL=https://cloud.example.com

# 32-byte (64 hex chars) master key used to encrypt remote-connection secrets.
# LEAVE EMPTY to auto-generate one into data/keys/app.key on first boot.
# IMPORTANT: changing or losing this key makes stored connection secrets unreadable.
APP_KEY=

# Shared secret between PHP and the WebSocket service. LEAVE EMPTY to auto-generate.
WS_SECRET=

# Set true when ANSNEW CLOUD is served over HTTPS (marks cookies Secure).
# Keep true in production: without it the session cookie can leak over plain HTTP.
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=43200
IDLE_TIMEOUT=1800

# --- Database -------------------------------------------------------------
# sqlite (default, zero-config) or mysql (see the `mysql` compose profile).
# NOTE: switching drivers on an existing install does NOT migrate data — the
# app would start on an empty database. See docs/DEPLOY.md.
DB_DRIVER=sqlite
DB_DATABASE=/var/www/data/ansnew.sqlite
DB_HOST=db
DB_PORT=3306
DB_USER=ansnew
DB_PASSWORD=
DB_NAME=ansnew

# --- Bootstrap administrator ---------------------------------------------
# If ADMIN_PASSWORD is empty a strong random password is generated and printed
# once in the php container logs (`docker compose logs php | grep -i password`).
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Minimum password length enforced by App\Support\Validator.
PASSWORD_MIN_LENGTH=10

# --- Uploads --------------------------------------------------------------
UPLOAD_MAX_BYTES=2147483648
CHUNK_SIZE=8388608
UPLOAD_TMP_DIR=/var/www/data/tmp

# --- Built-in text / code editor ------------------------------------------
# Largest file the editor will open or save. The contents are held in memory
# and round-tripped through the browser, so this is deliberately much smaller
# than UPLOAD_MAX_BYTES.
EDIT_MAX_BYTES=5242880

# --- Rate limiting --------------------------------------------------------
# Requests per RATE_LIMIT_WINDOW seconds, per user (or per IP when anonymous).
# Thumbnails draw from their own RATE_LIMIT_ASSET_REQUESTS bucket so browsing a
# folder full of images cannot starve file operations (and vice versa).
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_ASSET_REQUESTS=1200
RATE_LIMIT_WINDOW=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE=30
LOGIN_LOCKOUT_MAX=3600

# How long (seconds) a password confirmation stays valid for a sensitive action
# (permanent delete, bulk clear, disconnect…).
SENSITIVE_GRANT_TTL=60

# --- Storage --------------------------------------------------------------
# Host directory bind-mounted as the default writable local mount.
STORAGE_HOST_PATH=./storage-root
# Default mount seeded on first boot (container-side path + display label).
# Must stay under /srv/storage/local so it matches the bind mount above.
DEFAULT_MOUNT_PATH=/srv/storage/local
DEFAULT_MOUNT_LABEL=Local Storage

# --- Encryption at rest ---------------------------------------------------
# File contents on LOCAL mounts are encrypted with AES-256-GCM (streaming,
# per-file data key wrapped by a master key). Remote mounts are not touched.
# Set to 0 to store new files in the clear (existing encrypted files still read).
ANSNEW_ENCRYPT_LOCAL=1
# Optional: supply the file master key from the environment instead of
# data/keys/file.key (64 hex chars). LOSING THIS KEY MAKES ENCRYPTED FILES
# UNRECOVERABLE — include data/keys/file.key in your backups.
# ANSNEW_FILE_KEY=
# Identifies which master key wrapped each file's data key (rotation hook).
ANSNEW_FILE_KEY_ID=1

TRASH_ENABLED=true
TRASH_RETENTION_DAYS=30

# --- Remote connections ---------------------------------------------------
# Allow remote adapters (HTTP/WebDAV, FTP, SFTP, SMB) to reach private/link-local
# networks.  Keep false unless you deliberately connect to internal hosts.
SSRF_ALLOW_PRIVATE=false
# Additional admin-approved hosts/CIDRs for remote connections (comma separated).
SSRF_ALLOWLIST=

# --- Job queue ------------------------------------------------------------
# A job whose worker dies is requeued once its lease expires; after
# JOB_MAX_ATTEMPTS it is failed. Retried jobs may repeat side effects.
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3

# --- Storage usage figures ------------------------------------------------
# The sidebar's per-drive size is a cached snapshot. Any change to a mount
# flags it stale and queues a re-scan; this is the minimum number of seconds
# between two automatic re-scans of the same mount (a bulk upload or delete
# emits many change events, we only want one scan). An explicit "rescan" from
# the UI ignores this.
USAGE_RESCAN_DEBOUNCE=30

# --- Network / TLS --------------------------------------------------------
# Trust X-Forwarded-For for the client IP (rate limiting, lockout, audit).
# Only enable when something you control (this stack's nginx, or your own
# reverse proxy) sits in front — otherwise the header is client-spoofable.
TRUST_PROXY=true

# Ports published by nginx.
#   HTTP_PORT         the app listener. Keep it CLOSED in the firewall in
#                     production (only 80/443 should be reachable).
#   PUBLIC_HTTP_PORT  public HTTP: ACME challenge + 301 redirect to HTTPS.
#   HTTPS_PORT        public HTTPS.
HTTP_PORT=8080
PUBLIC_HTTP_PORT=80
HTTPS_PORT=443
# TLS material, kept OUTSIDE the project so the private key is not cloud-synced.
# Regenerate with scripts/make-cert.sh; issue a real cert with
# scripts/init-letsencrypt.sh.
CERTS_HOST_PATH=/etc/ansnew/tls
# Directory certbot writes its HTTP-01 challenge into (mounted read-only into nginx).
ACME_WEBROOT_HOST_PATH=/var/www/ansnew-acme

# --- Backups --------------------------------------------------------------
# Container path for `ansnew:backup` output, and the host dir it maps to.
# Keep this OUTSIDE the data volume (and ideally off-box).
ANSNEW_BACKUP_DIR=/backups
BACKUP_HOST_PATH=/srv/ansnew-backups

# Drive health probing (SMART via smartctl). Off by default: it needs device
# access that a container normally does not have.
ANSNEW_SMART_ENABLED=0

# --- NAS (SMB) option ------------------------------------------------------
# Opt-in network file share. Enable with `docker compose --profile nas up -d`
# (or set COMPOSE_PROFILES=nas below) so Windows "Map Network Drive" and mobile
# SMB apps can drop files straight into the file manager's _inbox folder. Files
# appear in the manager at once; nas-watch imports them via a rate-limited queue.
# WARNING: do NOT enable this profile on a public-internet host.
NAS_SHARE_NAME=ansnew
NAS_USER=ansnew
NAS_PASS=change-me-in-production
NAS_INGEST_MBPS=50
NAS_PORT=445
# Uncomment to enable the nas profile on every `docker compose up`:
# COMPOSE_PROFILES=nas
